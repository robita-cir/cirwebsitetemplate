{
  "name": "cir-website-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static website template for a research centre, built with Astro.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:launch": "node scripts/launch-check.mjs",
    "check": "npm run build && npm run check:html",
    "check:all": "npm run check && npm run check:launch"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "html-validate": "^11.16.2",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2"
  }
}
