---
interface Props {
  tone?: 'neutral' | 'accent' | 'highlight';
}

const { tone = 'neutral' } = Astro.props;

const tones: Record<NonNullable<Props['tone']>, string> = {
  neutral: 'border-line bg-paper text-muted',
  accent: 'border-accent/30 bg-accent/10 text-accent',
  highlight: 'border-highlight/30 bg-highlight/10 text-highlight',
};
---

<span
  class:list={[
    'inline-flex max-w-full items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[0.68rem] uppercase tracking-[0.12em] leading-none',
    tones[tone],
  ]}
>
  <slot />
</span>
