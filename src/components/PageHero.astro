---
// Header band for inner pages: the same type and rhythm as the homepage hero, without the figure.
// Detail pages pass `crumbs` to show a breadcrumb trail above the eyebrow, and `sample` to mark placeholder content.
import Breadcrumb from './Breadcrumb.astro';
import SampleTag from './SampleTag.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  sample?: boolean;
}

const { eyebrow, title, lead, crumbs, sample = false } = Astro.props;

// Long titles (for example, a full project or person name) step the heading down, so they stay within a few lines.
const titleSize = title.length > 120 ? 'text-[2.2rem] sm:text-[2.5rem]' : title.length > 70 ? 'text-[2.6rem] sm:text-[3rem]' : '';
---

<section class="border-b border-line">
  <div class="mx-auto w-full max-w-page px-5 pb-16 pt-8 sm:px-8 lg:pb-20 lg:pt-12">
    {crumbs && crumbs.length > 0 && (
      <div class="mb-10">
        <Breadcrumb items={crumbs} />
      </div>
    )}
    {
      (eyebrow || sample) && (
        <div class="rise rise-d0 flex flex-wrap items-center gap-3">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {sample && <SampleTag />}
        </div>
      )
    }
    <h1 class:list={['rise rise-d120 mt-6 max-w-[22ch]', titleSize]}>{title}</h1>
    {lead && <p class="rise rise-d240 mt-7 max-w-2xl text-lg leading-relaxed text-muted">{lead}</p>}
    {
      Astro.slots.has('default') && (
        <div class="rise rise-d360 mt-10">
          <slot />
        </div>
      )
    }
  </div>
</section>
