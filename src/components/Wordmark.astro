---
// Text wordmark for the header. The CIR emblem and institute logo are added once the brand decision is made.
import { site } from '../config/site';
---

<span class="inline-flex items-center gap-3.5">
  <span class="grid size-11 place-items-center bg-ink font-display text-[0.95rem] font-medium tracking-tight text-paper">
    CIR
  </span>
  <span class="hidden leading-tight sm:block">
    <span class="block font-display text-[1.15rem] font-medium text-ink">{site.name}</span>
    <span class="block font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted">{site.instituteShort}</span>
  </span>
</span>
