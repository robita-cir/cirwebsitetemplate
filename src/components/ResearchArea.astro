---
interface Props {
  code: string;
  title: string;
  description: string;
  examples?: string[];
  href?: string;
}

const { code, title, description, examples = [], href } = Astro.props;
---

<article class="flex h-full flex-col border-t-2 border-accent pt-6" data-reveal>
  <p class="font-mono text-xs tracking-[0.14em] text-muted">{code}</p>
  <h3 class="mt-4 text-[1.5rem] leading-snug">
    {
      href ? (
        <a href={href} class="underline-offset-4 hover:text-accent hover:underline">{title}</a>
      ) : (
        title
      )
    }
  </h3>
  <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{description}</p>
  {
    examples.length > 0 && (
      <ul class="mt-auto space-y-2.5 border-t border-line pt-5 text-sm leading-snug text-ink">
        {examples.map((example) => (
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="mt-2 h-px w-3 shrink-0 bg-accent"></span>
            <span>{example}</span>
          </li>
        ))}
      </ul>
    )
  }
</article>
