---
import { nav, robita } from '../config/site';
import Wordmark from './Wordmark.astro';

const { pathname } = Astro.url;
const isCurrent = (href: string) => pathname === href || pathname.startsWith(href);
// Labels stay on one line: the body allows long words to break anywhere, which would split "About" or "Contact".
const linkClass =
  'whitespace-nowrap text-[0.78rem] uppercase tracking-[0.1em] text-muted transition-colors duration-200 hover:text-ink aria-[current=page]:text-ink';
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-20 w-full max-w-page items-center justify-between gap-6 px-5 sm:px-8">
    <a href="/" class="shrink-0">
      <Wordmark />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-5 xl:flex">
      {
        nav.map((item) => (
          <a href={item.href} class={linkClass} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <!-- The only place the student club is linked from the header. It is a pointer, nothing more. -->
      <a
        href={robita.url}
        class="ml-2 inline-flex items-center gap-1 whitespace-nowrap border border-accent px-3 py-2 text-[0.78rem] uppercase tracking-[0.1em] text-accent transition-colors hover:bg-accent hover:text-on-accent"
      >
        {robita.label}
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(student club website)</span>
      </a>
    </nav>

    <details class="group relative xl:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border border-line text-ink [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Menu</span>
        <span aria-hidden="true" class="block h-3.5 w-5 border-y-2 border-current group-open:border-transparent"></span>
      </summary>
      <nav aria-label="Mobile" class="absolute right-0 top-12 w-64 border border-line bg-paper p-2 shadow-xl">
        {
          nav.map((item) => (
            <a href={item.href} class="block px-3 py-2.5 text-ink hover:bg-band">
              {item.label}
            </a>
          ))
        }
        <a href={robita.url} class="mt-1 block px-3 py-2.5 font-medium text-accent hover:bg-band">
          {robita.label} ↗
        </a>
      </nav>
    </details>
  </div>
</header>
