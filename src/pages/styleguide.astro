---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import EventCard from '../components/EventCard.astro';
import ManipulatorFigure from '../components/ManipulatorFigure.astro';
import NewsItem from '../components/NewsItem.astro';
import PartnerMark from '../components/PartnerMark.astro';
import PersonCard from '../components/PersonCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ResearchArea from '../components/ResearchArea.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stat from '../components/Stat.astro';

// Internal page for reviewing the design system. Not linked from the navigation.
// Delete this file (and its noindex) before launch.
const tokens = [
  { name: 'paper', swatch: 'bg-paper', hex: '#FFFFFF' },
  { name: 'band', swatch: 'bg-band', hex: '#F6F7F9, alternate sections' },
  { name: 'ink', swatch: 'bg-ink', hex: '#101030, headings and body' },
  { name: 'muted', swatch: 'bg-muted', hex: '#4A4F66, secondary text' },
  { name: 'line', swatch: 'bg-line', hex: '#D9DCE3, rules only' },
  { name: 'accent', swatch: 'bg-accent', hex: '#17766A, links and labels' },
  { name: 'brand', swatch: 'bg-brand', hex: '#30A090, decorative only' },
  { name: 'highlight', swatch: 'bg-highlight', hex: '#8A5A12, emphasis' },
];
---

<Layout title="Styleguide" noindex>
  <div class="mx-auto w-full max-w-page space-y-28 px-5 py-20 sm:px-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Internal · not for launch</p>
      <h1 class="mt-4">Design system</h1>
      <p class="mt-5 text-lg text-muted">Every token and component used on the homepage, in the light theme.</p>
    </header>

    <section aria-labelledby="colour">
      <SectionHeader number="01" label="Foundations" title="Colour" lead="White is the page, the band colour alternates sections, and the navy and teal come from the institute logo." />
      <ul class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          tokens.map((token) => (
            <li class="flex items-center gap-4 bg-paper p-4">
              <span class:list={['size-12 shrink-0 border border-line', token.swatch]} aria-hidden="true"></span>
              <span class="min-w-0">
                <span class="block font-mono text-sm text-ink">{token.name}</span>
                <span class="block text-xs text-muted">{token.hex}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="type">
      <SectionHeader number="02" label="Foundations" title="Typography" lead="Source Serif 4 for headings and display, Inter for interface and body, JetBrains Mono for labels and data." />
      <div class="mt-12 space-y-10">
        <div>
          <p class="eyebrow">Display · h1</p>
          <p class="mt-3 font-display text-[clamp(2.6rem,4.4vw+1rem,4.4rem)] leading-[1.04] tracking-[-0.02em]">Intelligent robots that perceive</p>
        </div>
        <div>
          <p class="eyebrow">Section · h2</p>
          <p class="mt-3 font-display text-4xl leading-tight">Four research directions</p>
        </div>
        <div>
          <p class="eyebrow">Card title · h3</p>
          <p class="mt-3 font-display text-2xl leading-snug">Learning Based Social Reactive Motion Planning</p>
        </div>
        <div>
          <p class="eyebrow">Body</p>
          <p class="mt-3 max-w-2xl text-lg leading-relaxed text-muted">Placeholder text for the facilities summary.</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="buttons">
      <SectionHeader number="03" label="Components" title="Buttons and badges" />
      <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-5">
        <Button>Primary</Button>
        <Button variant="outline">Outline</Button>
        <Button variant="link">Text link →</Button>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <Badge>Neutral</Badge>
        <Badge tone="accent">Active</Badge>
        <Badge tone="highlight">Workshop</Badge>
      </div>
    </section>

    <section aria-labelledby="figure">
      <SectionHeader number="04" label="Components" title="Technical figure" lead="Used in the hero. Joint angles and link lengths are computed from fixed values." />
      <div class="mt-12 max-w-2xl">
        <ManipulatorFigure />
      </div>
    </section>

    <section aria-labelledby="research">
      <SectionHeader number="05" label="Components" title="Research areas" />
      <div class="mt-12 grid gap-12 md:grid-cols-2">
        <ResearchArea code="A" title="Human–robot interaction" description="Robots that read human intent and adapt when they share space with people." examples={['Example project title one', 'Example project title two']} />
        <ResearchArea code="B" title="Perception and manipulation" description="Learning to see objects and grasp them." />
      </div>
    </section>

    <section aria-labelledby="people">
      <SectionHeader number="06" label="Components" title="People" />
      <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 xl:grid-cols-4">
        <PersonCard name="CIR Head" role="Head of the centre" dept="Department name" />
        <PersonCard name="Professor 1" role="Assistant Professor" dept="Department of Example" interests={['Interest one', 'Interest two']} />
      </div>
    </section>

    <section aria-labelledby="projects">
      <SectionHeader number="07" label="Components" title="Project list" />
      <ul class="mt-12 border-b border-line">
        <ProjectRow title="Project 1" team="PhD 1" status="Active" />
      </ul>
    </section>

    <section aria-labelledby="stats">
      <SectionHeader number="08" label="Components" title="Statistics" />
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        <Stat value={11} label="Student research projects" />
        <Stat value={4} label="Externally funded programmes" />
        <Stat value={10} suffix="+" label="Partner institutions and companies" />
      </div>
    </section>

    <section aria-labelledby="news">
      <SectionHeader number="09" label="Components" title="News and events" />
      <ul class="mt-12 border-b border-line">
        <NewsItem date="2026-01-23" title="Sample dated news item" kind="Workshop" />
      </ul>
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <EventCard title="Sample event card" date="2026-01-23" endDate="2026-01-25" venue="Venue name, City" type="Workshop" />
        <Card>
          <p class="eyebrow">Plain card</p>
          <p class="mt-3 text-muted">Bordered surface for any content block.</p>
        </Card>
      </div>
    </section>

    <section aria-labelledby="partners">
      <SectionHeader number="10" label="Components" title="Partners" />
      <ul class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        <PartnerMark name="Sample partner" country="Country" />
        <PartnerMark name="Sample partner two" country="Country" />
      </ul>
    </section>
  </div>
</Layout>
