---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { byOrder } from '../lib/format';

const albums = (await getCollection('gallery')).sort(byOrder);
---

<Layout title="Gallery" description="Photographs of the Centre for Intelligent Robotics: workshops, training programmes, talks and the laboratory.">
  <PageHero
    eyebrow="Gallery"
    title="The laboratory, the workshops and the people"
    lead="Photographs from workshops, training programmes and talks, and from the laboratory and its robots. Albums are listed below as they are prepared."
  />

  <section class="mx-auto w-full max-w-page px-5 py-24 sm:px-8">
    <SectionHeader number="01" label="Albums" title="Albums" lead="Each album is a set of photographs with a caption and date. Photographs are being collected for every album." />
    <div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 xl:grid-cols-4">
      {
        albums.map((album) => (
          <article data-reveal>
            <a href={`/gallery/${album.id}/`} class="group block" aria-describedby={`album-${album.id}`}>
              <div class="figure-grid flex aspect-[4/3] items-end border border-line bg-band p-5 transition-colors duration-300 group-hover:border-accent/60">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-muted">Photographs to be supplied</p>
              </div>
            </a>
            <h3 class="mt-5 text-[1.3rem] leading-snug">
              <a href={`/gallery/${album.id}/`} class="underline-offset-4 hover:text-accent hover:underline">{album.data.title}</a>
            </h3>
            <p id={`album-${album.id}`} class="sr-only">Album: {album.data.title}</p>
            {album.data.period && <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-accent">{album.data.period}</p>}
            <p class="mt-3 text-sm leading-relaxed text-muted">{album.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-band">
    <div class="mx-auto w-full max-w-page px-5 py-24 sm:px-8">
      <EmptyState title="Have photographs from a centre event?">
        Send them to the centre at centre@example.org with the event, date and the names of anyone shown, so that they can be captioned and used with permission.
      </EmptyState>
    </div>
  </section>
</Layout>
